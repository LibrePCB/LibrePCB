import { Data } from "../api.slint";

export component ToolTip inherits Rectangle {
    in property <string> text;
    in property <string> shortcut;
    in property <bool> delayed: true;

    width: min(self.preferred-width, 400px);
    height: self.preferred-height;
    background: Data.theme.tooltip;
    border-color: Data.theme.tooltip-border;
    border-width: 1px;
    border-radius: 5px;
    opacity: 0;

    animate opacity {
        delay: delayed ? 600ms : 0;
        duration: delayed ? 150ms : 0;
    }

    HorizontalLayout {
        padding: 3px;
        padding-left: 5px;
        padding-right: 5px;
        spacing: 5px;

        text-txt := Text {
            horizontal-alignment: left;
            vertical-alignment: center;
            wrap: word-wrap;
            font-size: 14px;
            color: Data.theme.tooltip-text;
            text: text;
            accessible-role: none;
        }

        if !shortcut.is-empty: shortcut-txt := Text {
            height: 18px;
            vertical-alignment: center;
            font-size: 12px;
            font-weight: 300;
            color: Data.theme.tooltip-text;
            text: "(" + shortcut + ")";
            accessible-role: none;
        }
    }

    init => {
        self.opacity = 1;
    }
}
