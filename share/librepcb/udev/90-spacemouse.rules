# udev rule granting non-root access to 3Dconnexion SpaceMouse and related
# 3D mouse HID devices, so LibrePCB can read them without running as root.
#
# 0x256F is 3Dconnexion's own vendor ID and is matched by vendor only.
# 0x046D is Logitech's vendor ID, used by legacy 3Dconnexion devices. It also
# covers unrelated Logitech peripherals, so only specific product IDs are
# matched. Add further product IDs here as needed.
#
# MODE="0666" is used instead of a dedicated group to avoid requiring group
# membership changes.

# 3Dconnexion devices (vendor match)
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="256f", MODE="0666"

# Legacy Logitech-era devices (product IDs only)
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c603", MODE="0666" # SpaceMouse Plus XT
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c605", MODE="0666" # CADman
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c606", MODE="0666" # SpaceMouse Classic
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c621", MODE="0666" # Spaceball 5000
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c623", MODE="0666" # Space Traveller 3D Mouse
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c625", MODE="0666" # SpacePilot 3D Mouse
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c626", MODE="0666" # SpaceNavigator 3D Mouse
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c627", MODE="0666" # SpaceExplorer 3D Mouse
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c628", MODE="0666" # SpaceNavigator for Notebooks
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c629", MODE="0666" # SpacePilot Pro 3D Mouse
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c62b", MODE="0666" # SpaceMouse Pro
