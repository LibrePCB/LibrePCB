{
  "openrpc": "1.2.6",
  "info": {
    "title": "LibrePCB RPC API",
    "version": "1.0.0",
    "description": "The JSON-RPC 2.0 API to control a running LibrePCB application. It is served by the RPC server which listens on a local TCP socket (127.0.0.1). See the RPC Server API documentation page for the transport protocol (framing, handshake, protocol-level methods)."
  },
  "methods": [
    {
      "name": "project/list",
      "summary": "List all open projects",
      "description": "Returns a list of all projects currently opened in the application. The returned projects are identified by their UUID, which is used as parameter for all project-related commands.",
      "params": [],
      "result": {
        "name": "projects",
        "schema": {
          "type": "object",
          "properties": {
            "projects": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "uuid": {
                    "type": "string",
                    "description": "The project UUID (null if the project file contains an invalid UUID)"
                  },
                  "name": { "type": "string", "description": "The project name" },
                  "author": { "type": "string", "description": "The project author" },
                  "version": { "type": "string", "description": "The project version" },
                  "path": { "type": "string", "description": "The absolute path of the project file" },
                  "modified": {
                    "type": "boolean",
                    "description": "Whether the project was modified since the last save"
                  }
                }
              }
            }
          }
        }
      },
      "errors": [
        { "code": -32002, "message": "Command failed" }
      ],
      "examples": [
        {
          "name": "No projects open",
          "params": [],
          "result": { "projects": [] }
        }
      ]
    },
    {
      "name": "project/get",
      "summary": "Get details about an open project",
      "description": "Returns the metadata, all schematic sheets and all boards of an open project.",
      "params": [
        {
          "name": "project",
          "description": "The UUID of the project (as returned by project/list)",
          "required": true,
          "schema": { "type": "string" }
        }
      ],
      "result": {
        "name": "project",
        "schema": {
          "type": "object",
          "properties": {
            "uuid": { "type": "string" },
            "name": { "type": "string" },
            "author": { "type": "string" },
            "version": { "type": "string" },
            "path": { "type": "string" },
            "modified": { "type": "boolean" },
            "sheets": {
              "type": "array",
              "description": "All schematic sheets of the project",
              "items": {
                "type": "object",
                "properties": {
                  "uuid": { "type": "string" },
                  "name": { "type": "string" }
                }
              }
            },
            "boards": {
              "type": "array",
              "description": "All boards of the project",
              "items": {
                "type": "object",
                "properties": {
                  "uuid": { "type": "string" },
                  "name": { "type": "string" }
                }
              }
            }
          }
        }
      },
      "errors": [
        { "code": -32003, "message": "Project not open" }
      ],
      "examples": [
        {
          "name": "Example",
          "params": { "project": "0b1c8866-eae5-4b67-a6b2-5e2b5aeb0f0b" },
          "result": {
            "uuid": "0b1c8866-eae5-4b67-a6b2-5e2b5aeb0f0b",
            "name": "Example Project",
            "author": "Jane Doe",
            "version": "v1",
            "path": "/home/user/Example Project/Example Project.lpp",
            "modified": false,
            "sheets": [
              { "uuid": "3aa64ba1-6c79-414c-8e6a-55a51e6e3f2d", "name": "Sheet 1" }
            ],
            "boards": [
              { "uuid": "c6250d82-3090-4a35-9c47-8121dbd6f384", "name": "default" }
            ]
          }
        }
      ]
    },
    {
      "name": "undostack/getStatus",
      "summary": "Get the state of a project's undo stack",
      "description": "Returns whether undo/redo is currently possible for the given project, and the corresponding command texts.",
      "params": [
        {
          "name": "project",
          "description": "The UUID of the project",
          "required": true,
          "schema": { "type": "string" }
        }
      ],
      "result": {
        "name": "status",
        "schema": {
          "type": "object",
          "properties": {
            "canUndo": { "type": "boolean", "description": "Whether undo is possible" },
            "canRedo": { "type": "boolean", "description": "Whether redo is possible" },
            "undoText": { "type": "string", "description": "The text of the undo command (empty if N/A)" },
            "redoText": { "type": "string", "description": "The text of the redo command (empty if N/A)" },
            "clean": { "type": "boolean", "description": "Whether the stack is in the clean state (the state of the last save)" }
          }
        }
      },
      "errors": [
        { "code": -32003, "message": "Project not open" }
      ],
      "examples": [
        {
          "name": "Example",
          "params": { "project": "0b1c8866-eae5-4b67-a6b2-5e2b5aeb0f0b" },
          "result": {
            "canUndo": false,
            "canRedo": false,
            "undoText": "",
            "redoText": "",
            "clean": true
          }
        }
      ]
    },
    {
      "name": "undostack/undo",
      "summary": "Undo the last command of a project",
      "description": "Undoes the last command in the given project's undo stack, i.e. the same as pressing Ctrl+Z in the GUI. The command appears in the undo stack of the GUI, so it can be redone by the user.",
      "params": [
        {
          "name": "project",
          "description": "The UUID of the project",
          "required": true,
          "schema": { "type": "string" }
        }
      ],
      "result": {
        "name": "status",
        "description": "The new state of the undo stack",
        "schema": {
          "type": "object",
          "properties": {
            "canUndo": { "type": "boolean" },
            "canRedo": { "type": "boolean" },
            "undoText": { "type": "string" },
            "redoText": { "type": "string" },
            "clean": { "type": "boolean" }
          }
        }
      },
      "errors": [
        { "code": -32003, "message": "Project not open" },
        { "code": -32002, "message": "Command failed" }
      ],
      "examples": [
        {
          "name": "Example",
          "params": { "project": "0b1c8866-eae5-4b67-a6b2-5e2b5aeb0f0b" },
          "result": {
            "canUndo": false,
            "canRedo": true,
            "undoText": "",
            "redoText": "Add component",
            "clean": false
          }
        }
      ]
    },
    {
      "name": "undostack/redo",
      "summary": "Redo the last undone command of a project",
      "description": "Redoes the last undone command in the given project's undo stack, i.e. the same as pressing Ctrl+Shift+Z in the GUI.",
      "params": [
        {
          "name": "project",
          "description": "The UUID of the project",
          "required": true,
          "schema": { "type": "string" }
        }
      ],
      "result": {
        "name": "status",
        "description": "The new state of the undo stack",
        "schema": {
          "type": "object",
          "properties": {
            "canUndo": { "type": "boolean" },
            "canRedo": { "type": "boolean" },
            "undoText": { "type": "string" },
            "redoText": { "type": "string" },
            "clean": { "type": "boolean" }
          }
        }
      },
      "errors": [
        { "code": -32003, "message": "Project not open" },
        { "code": -32002, "message": "Command failed" }
      ],
      "examples": [
        {
          "name": "Example",
          "params": { "project": "0b1c8866-eae5-4b67-a6b2-5e2b5aeb0f0b" },
          "result": {
            "canUndo": true,
            "canRedo": false,
            "undoText": "Add component",
            "redoText": "",
            "clean": false
          }
        }
      ]
    }
  ]
}
