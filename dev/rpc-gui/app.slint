import {
    Button,
    LineEdit,
    Spinner,
    TextEdit,
} from "std-widgets.slint";
import { ProtocolPage } from "pages/protocol.slint";
import {
    ProjectEditorPage,
    ProjectRowData,
} from "pages/project_editor.slint";
import { UndoStackPage } from "pages/undo_stack.slint";
import {
    RemoteLibraryPage,
    LibraryRowData,
} from "pages/remote_library.slint";
import { WorkspaceDbPage } from "pages/workspace_db.slint";

export component AppWindow inherits Window {
    title: "LibrePCB RPC GUI";
    preferred-width: 1100px;
    preferred-height: 800px;

    // --- Connection state (sidebar) ---------------------------------------
    in property <bool> connected;
    in property <bool> authenticated;
    in property <bool> pending;
    in-out property <string> token;

    // --- Navigation (sidebar) ---------------------------------------------
    in property <[string]> classes;
    in property <int> current-page: -1;
    callback select-class(int);

    // --- Log (bottom) ------------------------------------------------------
    in property <string> log;

    // --- Protocol page ----------------------------------------------------
    callback ping-clicked();

    // --- ProjectEditor page -----------------------------------------------
    in-out property <string> project-path;
    in property <[ProjectRowData]> projects;
    in property <string> project-details;
    callback pe-open-clicked();
    callback pe-list-clicked();
    callback pe-get-clicked(int);
    callback pe-save-clicked(int);
    callback pe-close-clicked(int);

    // --- UndoStack page ----------------------------------------------------
    in property <[string]> project-entries;
    in-out property <int> undo-project-index: -1;
    in property <bool> undo-handle-valid;
    in property <string> undo-details;
    callback undo-select-project(string);
    callback undo-get-clicked();
    callback undo-undo-clicked();
    callback undo-redo-clicked();

    // --- RemoteLibrary page ------------------------------------------------
    in property <[LibraryRowData]> libraries;
    in property <string> library-details;
    callback rl-list-clicked();
    callback rl-check-toggled(int, bool);
    callback rl-install-clicked();
    callback rl-uninstall-clicked();
    callback rl-get-clicked(int);

    // --- WorkspaceDb page --------------------------------------------------
    in property <int> progress;
    callback db-wait-clicked();

    // --- Connection callbacks ------------------------------------------------
    callback connect-clicked();
    callback init-clicked();

    HorizontalLayout {
        // Sidebar: connection controls, then the class list.
        VerticalLayout {
            width: 200px;

            VerticalLayout {
                padding: 8px;
                padding-bottom: 4px;
                spacing: 6px;

                Button {
                    text: root.connected ? "✕ Disconnect" : "⚡ Connect";
                    clicked => { root.connect-clicked(); }
                }

                LineEdit {
                    text <=> root.token;
                    placeholder-text: "Access Token";
                }

                Button {
                    text: root.pending ? "Cancel" : "Initialize";
                    enabled: root.connected;
                    clicked => { root.init-clicked(); }
                }

                HorizontalLayout {
                    spacing: 6px;

                    VerticalLayout {
                        alignment: center;

                        Rectangle {
                            width: 10px;
                            height: 10px;
                            border-radius: 5px;
                            background: !root.connected ? #c04040
                                : root.authenticated ? #40a040 : #e0a020;
                        }
                    }

                    Text {
                        text: !root.connected ? "Disconnected"
                            : root.authenticated ? "Authenticated"
                            : "Connected";
                        color: !root.connected ? #c04040
                            : root.authenticated ? #40a040 : #e0a020;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    Spinner {
                        width: 16px;
                        height: 16px;
                        indeterminate: true;
                        visible: root.pending;
                    }
                }
            }

            // Visual separation between connection and navigation.
            VerticalLayout {
                padding-left: 8px;
                padding-right: 8px;

                Rectangle {
                    height: 1px;
                    background: #c0c0c0;
                }
            }

            VerticalLayout {
                padding: 8px;
                padding-top: 4px;
                spacing: 4px;
                alignment: start;

                for class-name[i] in root.classes: Button {
                    text: class-name;
                    primary: i == root.current-page;
                    clicked => { root.select-class(i); }
                }
            }

            Rectangle {
                vertical-stretch: 1;
            }
        }

        // The page of the selected class, plus the log at the bottom.
        VerticalLayout {
            padding: 8px;
            spacing: 8px;

            if root.current-page == 0 : ProtocolPage {
                vertical-stretch: 1;
                authenticated: root.authenticated;
                ping-clicked => { root.ping-clicked(); }
            }
            if root.current-page == 1 : ProjectEditorPage {
                vertical-stretch: 1;
                authenticated: root.authenticated;
                path <=> root.project-path;
                projects: root.projects;
                details: root.project-details;
                open-clicked => { root.pe-open-clicked(); }
                list-clicked => { root.pe-list-clicked(); }
                get-clicked(i) => { root.pe-get-clicked(i); }
                save-clicked(i) => { root.pe-save-clicked(i); }
                close-clicked(i) => { root.pe-close-clicked(i); }
            }
            if root.current-page == 2 : UndoStackPage {
                vertical-stretch: 1;
                authenticated: root.authenticated;
                project-entries: root.project-entries;
                current-index <=> root.undo-project-index;
                handle-valid: root.undo-handle-valid;
                details: root.undo-details;
                select-project(value) => { root.undo-select-project(value); }
                get-clicked => { root.undo-get-clicked(); }
                undo-clicked => { root.undo-undo-clicked(); }
                redo-clicked => { root.undo-redo-clicked(); }
            }
            if root.current-page == 3 : RemoteLibraryPage {
                vertical-stretch: 1;
                authenticated: root.authenticated;
                libraries: root.libraries;
                details: root.library-details;
                list-clicked => { root.rl-list-clicked(); }
                check-toggled(i, checked) => { root.rl-check-toggled(i, checked); }
                install-clicked => { root.rl-install-clicked(); }
                uninstall-clicked => { root.rl-uninstall-clicked(); }
                get-clicked(i) => { root.rl-get-clicked(i); }
            }
            if root.current-page == 4 : WorkspaceDbPage {
                vertical-stretch: 1;
                authenticated: root.authenticated;
                progress: root.progress;
                wait-clicked => { root.db-wait-clicked(); }
            }
            if root.current-page < 0 : Text {
                vertical-stretch: 1;
                text: "No page for this class (yet).";
                color: #808080;
            }

            // The log keeps a fixed height (no splitter in this Slint).
            TextEdit {
                height: 160px;
                text: root.log;
                read-only: true;
                font-family: "DejaVu Sans Mono";
                font-size: 12px;

                changed text => {
                    self.viewport-y = self.visible-height - self.viewport-height
                }
            }
        }
    }
}
