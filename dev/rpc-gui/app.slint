import {
    Button,
    LineEdit,
    ProgressIndicator,
    Spinner,
    VerticalBox,
    HorizontalBox,
    TextEdit,
    ListView,
} from "std-widgets.slint";

struct ProjectData {
    name: string,
    path: string,
    dirty: bool,
}

export component AppWindow inherits Window {
    title: "LibrePCB RPC GUI";
    preferred-width: 1024px;
    preferred-height: 800px;

    in property <bool> connected;
    in property <bool> pending;
    in-out property <string> token;
    in-out property <string> project-path;
    in property <string> log: "Foo\nBar";
    in property <int> progress;
    in property <[ProjectData]> projects;

    callback connect_clicked();
    callback init_clicked();
    callback open_project();
    callback watch_clicked();
    callback list_projects();
    callback close_project(int);

    VerticalBox {
        HorizontalBox {
            Button {
                text: root.connected ? "Disconnect" : "Connect";
                clicked => { root.connect_clicked(); }
            }

            LineEdit {
                text <=> root.token;
                placeholder-text: "Access Token";
            }

            Button {
                text: root.pending ? "Cancel" : "Initialize";
                enabled: root.connected;
                clicked => { root.init_clicked(); }
            }

            Spinner {
                indeterminate: true;
                visible: root.pending;
            }
        }

        HorizontalBox {
            LineEdit {
                horizontal-stretch: 1;
                text <=> root.project-path;
                placeholder-text: "Project File Path";
            }

            Button {
                text: "Open Project";
                enabled: root.connected;
                clicked => { root.open_project(); }
            }
        }

        HorizontalBox {
            Button {
                text: "List Projects";
                enabled: root.connected;
                clicked => { root.list-projects(); }
            }
        }

        ListView {
            vertical-stretch: 2;

            for project[i] in root.projects: HorizontalLayout {
                spacing: 8px;

                VerticalLayout {
                    horizontal-stretch: 1;

                    Text {
                        text: project.name;
                        font-weight: 700;
                    }

                    Text {
                        text: project.path;
                        font-size: 10px;
                        color: #808080;
                        overflow: elide;
                    }
                }

                Text {
                    text: project.dirty ? "● dirty" : "";
                    color: #d08000;
                    font-size: 10px;
                    vertical-alignment: center;
                }

                Button {
                    text: "✕";
                    clicked => { root.close-project(i); }
                }
            }
        }

        HorizontalBox {
            ProgressIndicator {
                horizontal-stretch: 1;
                progress: root.progress / 100;
            }

            Button {
                text: "Watch Libraries";
                enabled: root.connected;
                clicked => { root.watch_clicked(); }
            }
        }

        TextEdit {
            text: log;
            font-family: "DejaVu Sans Mono";
            font-size: 12px;
            read-only: true;

            changed text => {
                self.viewport-y = self.visible-height - self.viewport-height
            }
        }
    }
}
