import {
    Button,
    LineEdit,
    Spinner,
    TextEdit,
} from "std-widgets.slint";
import { ProtocolPage } from "pages/protocol.slint";
import {
    ProjectEditorPage,
    ProjectRowData,
} from "pages/project_editor.slint";
import { GraphicsExportPage } from "pages/graphics_export.slint";
import { UndoStackPage } from "pages/undo_stack.slint";
import {
    RemoteLibraryPage,
    LibraryRowData,
} from "pages/remote_library.slint";
import { RuleCheckPage, RuleCheckMessageData } from "pages/rule_check.slint";
import { WorkspacePage } from "pages/workspace.slint";
import { WorkspaceDbPage } from "pages/workspace_db.slint";

export component AppWindow inherits Window {
    title: "LibrePCB RPC GUI";
    preferred-width: 1100px;
    preferred-height: 800px;

    // --- Connection state (sidebar) ---------------------------------------
    in property <bool> connected;
    in property <bool> authenticated;
    in property <bool> pending;
    in-out property <string> token;

    // --- Navigation (sidebar) ---------------------------------------------
    in property <[string]> classes;
    in property <int> selected-class: -1;
    in property <int> current-page: -1;
    callback select-class(int);

    // --- Log (bottom) ------------------------------------------------------
    in property <string> log;

    // --- Protocol page ----------------------------------------------------
    callback ping-clicked();

    // --- ProjectEditor page -----------------------------------------------
    in-out property <string> project-path;
    in-out property <string> create-path;
    in-out property <string> create-name;
    in property <[ProjectRowData]> projects;
    in property <string> project-details;
    in-out property <string> pe-name;
    in-out property <string> pe-author;
    in-out property <string> pe-version;
    in-out property <string> pe-locales;
    in-out property <string> pe-norms;
    callback pe-create-clicked();
    callback pe-open-clicked();
    callback pe-list-clicked();
    callback pe-get-clicked(int);
    callback pe-save-clicked(int);
    callback pe-close-clicked(int);
    callback pe-apply-clicked();

    // --- UndoStack page ----------------------------------------------------
    in property <[string]> project-entries;
    in-out property <int> undo-project-index: -1;
    in property <bool> undo-handle-valid;
    in property <string> undo-details;
    callback undo-select-project(string);
    callback undo-get-clicked();
    callback undo-undo-clicked();
    callback undo-redo-clicked();

    // --- RemoteLibrary page ------------------------------------------------
    in property <[LibraryRowData]> libraries;
    in property <string> library-details;
    callback rl-list-clicked();
    callback rl-check-toggled(int, bool);
    callback rl-apply-clicked();
    callback rl-get-clicked(int);

    // --- RuleCheck page ----------------------------------------------------
    in property <bool> rulecheck-running;
    in property <int> progress;
    in property <[string]> check-entries;
    in-out property <int> check-index: -1;
    in-out property <bool> quick;
    in property <[RuleCheckMessageData]> check-messages;
    callback rc-select-check(string);
    callback rc-refresh-clicked();
    callback rc-run-clicked();
    callback rc-cancel-clicked();
    callback rc-check-toggled(int, bool);
    callback rc-approve-clicked();
    callback rc-unapprove-clicked();

    // --- WorkspaceDb page --------------------------------------------------
    in-out property <string> db-query: "SELECT sql FROM sqlite_schema WHERE sql IS NOT NULL";
    in property <[string]> db-get-entries: [
        "library",
        "component_category",
        "package_category",
        "symbol",
        "package",
        "component",
        "device",
        "organization",
    ];
    in-out property <int> db-get-index: 0;
    in-out property <string> db-get-type: "library";
    in-out property <string> db-get-input: "";
    in property <string> db-details;
    callback db-wait-clicked();
    callback db-query-clicked();
    callback db-get-clicked();

    // --- Workspace page ----------------------------------------------------
    in property <string> workspace-details;
    callback ws-get-clicked();

    // --- GraphicsExport page -----------------------------------------------
    in property <[string]> ge-entries;
    in-out property <int> ge-index: -1;
    in-out property <int> ge-dpi: 100;
    in-out property <bool> ge-flip: false;
    in-out property <bool> ge-realistic: false;
    in property <image> ge-image;
    in property <bool> ge-running;
    in property <string> ge-status;
    callback ge-select-render(string);
    callback ge-refresh-clicked();
    callback ge-render-clicked();

    // --- Connection callbacks ------------------------------------------------
    callback connect-clicked();
    callback init-clicked();

    HorizontalLayout {
        // Sidebar: connection controls, then the class list.
        VerticalLayout {
            width: 200px;

            VerticalLayout {
                padding: 8px;
                padding-bottom: 4px;
                spacing: 6px;

                HorizontalLayout {
                    spacing: 6px;

                    Button {
                        text: root.connected ? "✕" : "⚡";
                        clicked => { root.connect-clicked(); }
                    }

                    Button {
                        horizontal-stretch: 1;
                        text: root.pending ? "Cancel" : "Initialize";
                        enabled: root.connected;
                        clicked => { root.init-clicked(); }
                    }
                }

                LineEdit {
                    text <=> root.token;
                    placeholder-text: "Access Token";
                }

                HorizontalLayout {
                    spacing: 6px;
                    padding-left: 5px;

                    VerticalLayout {
                        alignment: center;

                        Rectangle {
                            width: 10px;
                            height: 10px;
                            border-radius: 5px;
                            background: !root.connected ? #c04040
                                : root.authenticated ? #40a040 : #e0a020;
                        }
                    }

                    Text {
                        text: !root.connected ? "Disconnected"
                            : root.authenticated ? "Authenticated"
                            : "Connected";
                        color: !root.connected ? #c04040
                            : root.authenticated ? #40a040 : #e0a020;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    Spinner {
                        width: 16px;
                        height: 16px;
                        indeterminate: true;
                        visible: root.pending;
                    }
                }
            }

            // Visual separation between connection and navigation.
            VerticalLayout {
                padding: 8px;

                Rectangle {
                    height: 1px;
                    background: #c0c0c0;
                }
            }

            VerticalLayout {
                padding: 8px;
                padding-top: 4px;
                spacing: 4px;
                alignment: start;

                for class-name[i] in root.classes: Button {
                    text: class-name;
                    primary: i == root.selected-class;
                    clicked => { root.select-class(i); }
                }
            }

            Rectangle {
                vertical-stretch: 1;
            }
        }

        // The page of the selected class, plus the log at the bottom.
        VerticalLayout {
            padding: 8px;
            spacing: 8px;

            if root.current-page == 0: ProtocolPage {
                vertical-stretch: 1;
                authenticated: root.authenticated;
                ping-clicked => { root.ping-clicked(); }
            }
            if root.current-page == 1: ProjectEditorPage {
                vertical-stretch: 1;
                authenticated: root.authenticated;
                path <=> root.project-path;
                create-path <=> root.create-path;
                create-name <=> root.create-name;
                projects: root.projects;
                details: root.project-details;
                pe-name <=> root.pe-name;
                pe-author <=> root.pe-author;
                pe-version <=> root.pe-version;
                pe-locales <=> root.pe-locales;
                pe-norms <=> root.pe-norms;
                create-clicked => { root.pe-create-clicked(); }
                open-clicked => { root.pe-open-clicked(); }
                list-clicked => { root.pe-list-clicked(); }
                get-clicked(i) => { root.pe-get-clicked(i); }
                save-clicked(i) => { root.pe-save-clicked(i); }
                close-clicked(i) => { root.pe-close-clicked(i); }
                apply-clicked => { root.pe-apply-clicked(); }
            }
            if root.current-page == 3: UndoStackPage {
                vertical-stretch: 1;
                authenticated: root.authenticated;
                project-entries: root.project-entries;
                current-index <=> root.undo-project-index;
                handle-valid: root.undo-handle-valid;
                details: root.undo-details;
                select-project(value) => { root.undo-select-project(value); }
                get-clicked => { root.undo-get-clicked(); }
                undo-clicked => { root.undo-undo-clicked(); }
                redo-clicked => { root.undo-redo-clicked(); }
            }
            if root.current-page == 4: RemoteLibraryPage {
                vertical-stretch: 1;
                authenticated: root.authenticated;
                libraries: root.libraries;
                details: root.library-details;
                list-clicked => { root.rl-list-clicked(); }
                check-toggled(i, checked) => { root.rl-check-toggled(i, checked); }
                apply-clicked => { root.rl-apply-clicked(); }
                get-clicked(i) => { root.rl-get-clicked(i); }
            }
            if root.current-page == 2: RuleCheckPage {
                vertical-stretch: 1;
                authenticated: root.authenticated;
                running: root.rulecheck-running;
                progress: root.progress;
                check-entries: root.check-entries;
                check-index <=> root.check-index;
                quick <=> root.quick;
                messages: root.check-messages;
                select-check(value) => { root.rc-select-check(value); }
                refresh-clicked => { root.rc-refresh-clicked(); }
                run-clicked => { root.rc-run-clicked(); }
                cancel-clicked => { root.rc-cancel-clicked(); }
                check-toggled(i, checked) => { root.rc-check-toggled(i, checked); }
                approve-clicked => { root.rc-approve-clicked(); }
                unapprove-clicked => { root.rc-unapprove-clicked(); }
            }
            if root.current-page == 5: WorkspaceDbPage {
                vertical-stretch: 1;
                authenticated: root.authenticated;
                progress: root.progress;
                query <=> root.db-query;
                get-entries: root.db-get-entries;
                get-index <=> root.db-get-index;
                get-type <=> root.db-get-type;
                get-input <=> root.db-get-input;
                details: root.db-details;
                wait-clicked => { root.db-wait-clicked(); }
                query-clicked => { root.db-query-clicked(); }
                get-clicked => { root.db-get-clicked(); }
            }
            if root.current-page == 6: GraphicsExportPage {
                vertical-stretch: 1;
                authenticated: root.authenticated;
                entries: root.ge-entries;
                current-index <=> root.ge-index;
                dpi <=> root.ge-dpi;
                flip <=> root.ge-flip;
                realistic <=> root.ge-realistic;
                image: root.ge-image;
                running: root.ge-running;
                status: root.ge-status;
                select-render(value) => { root.ge-select-render(value); }
                refresh-clicked => { root.ge-refresh-clicked(); }
                render-clicked => { root.ge-render-clicked(); }
            }
            if root.current-page == 7: WorkspacePage {
                vertical-stretch: 1;
                authenticated: root.authenticated;
                details: root.workspace-details;
                get-clicked => { root.ws-get-clicked(); }
            }
            if root.current-page < 0: Text {
                vertical-stretch: 1;
                text: "No page for this class (yet).";
                color: #808080;
            }

            // The log keeps a fixed height (no splitter in this Slint).
            TextEdit {
                height: 160px;
                text: root.log;
                read-only: true;
                font-family: "DejaVu Sans Mono";
                font-size: 12px;

                changed text => {
                    self.viewport-y = self.visible-height - self.viewport-height
                }
            }
        }
    }
}
