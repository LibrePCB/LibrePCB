import { Button, LineEdit, ListView, TextEdit } from "std-widgets.slint";

export struct ProjectRowData {
    name: string,
    path: string,
    dirty: bool,
}

export component ProjectEditorPage {
    in property <bool> authenticated;
    in-out property <string> path;
    in property <[ProjectRowData]> projects;
    in property <string> details;
    // --- The set form (absent arguments are not modified) --------------
    in-out property <string> pe-name;
    in-out property <string> pe-author;
    in-out property <string> pe-version;
    in-out property <string> pe-locales;
    in-out property <string> pe-norms;
    callback open-clicked();
    callback list-clicked();
    callback get-clicked(int);
    callback save-clicked(int);
    callback close-clicked(int);
    callback apply-clicked();

    VerticalLayout {
        spacing: 8px;

        HorizontalLayout {
            spacing: 6px;

            LineEdit {
                text <=> root.path;
                placeholder-text: "Project File Path";
                horizontal-stretch: 1;
            }

            Button {
                text: "Open";
                enabled: root.authenticated;
                clicked => { root.open-clicked(); }
            }

            Button {
                text: "List";
                enabled: root.authenticated;
                clicked => { root.list-clicked(); }
            }
        }

        ListView {
            vertical-stretch: 2;

            for project[i] in root.projects: HorizontalLayout {
                spacing: 6px;

                VerticalLayout {
                    horizontal-stretch: 1;

                    Text {
                        text: project.name;
                        font-weight: 700;
                    }

                    Text {
                        text: project.path;
                        font-size: 10px;
                        color: #808080;
                        overflow: elide;
                    }
                }

                Text {
                    text: project.dirty ? "● dirty" : "";
                    color: #d08000;
                    font-size: 10px;
                    vertical-alignment: center;
                }

                Button {
                    text: "Get";
                    enabled: root.authenticated;
                    clicked => { root.get-clicked(i); }
                }

                Button {
                    text: "Save";
                    enabled: root.authenticated;
                    clicked => { root.save-clicked(i); }
                }

                Button {
                    text: "✕";
                    enabled: root.authenticated;
                    clicked => { root.close-clicked(i); }
                }
            }
        }

        // The set form: fields are pre-filled from the last get result;
        // Apply sends only the fields modified by the user.
        HorizontalLayout {
            spacing: 6px;

            LineEdit {
                text <=> root.pe-name;
                placeholder-text: "Name";
                horizontal-stretch: 2;
            }

            LineEdit {
                text <=> root.pe-author;
                placeholder-text: "Author";
                horizontal-stretch: 2;
            }

            LineEdit {
                text <=> root.pe-version;
                placeholder-text: "Version";
                horizontal-stretch: 1;
            }

            Button {
                text: "Apply";
                enabled: root.authenticated;
                clicked => { root.apply-clicked(); }
            }
        }

        HorizontalLayout {
            spacing: 6px;

            LineEdit {
                text <=> root.pe-locales;
                placeholder-text: "Locales (comma-separated)";
                horizontal-stretch: 1;
            }

            LineEdit {
                text <=> root.pe-norms;
                placeholder-text: "Norms (comma-separated)";
                horizontal-stretch: 1;
            }
        }

        TextEdit {
            vertical-stretch: 3;
            min-height: 180px;
            text: root.details;
            read-only: true;
            font-family: "DejaVu Sans Mono";
            font-size: 12px;
        }
    }
}
