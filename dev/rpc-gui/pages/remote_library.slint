import { Button, CheckBox, ListView, TextEdit } from "std-widgets.slint";

export struct LibraryRowData {
    checked: bool,
    uuid: string,
    name: string,
    installed: string,
    online: string,
    outdated: bool,
}

export component RemoteLibraryPage {
    in property <bool> authenticated;
    in property <[LibraryRowData]> libraries;
    in property <string> details;
    callback list-clicked();
    callback check-toggled(int, bool);
    callback install-clicked();
    callback uninstall-clicked();
    callback get-clicked(int);

    VerticalLayout {
        HorizontalLayout {
            spacing: 6px;

            Button {
                text: "List";
                enabled: root.authenticated;
                clicked => { root.list-clicked(); }
            }

            Button {
                text: "Install Checked";
                enabled: root.authenticated;
                clicked => { root.install-clicked(); }
            }

            Button {
                text: "Uninstall Checked";
                enabled: root.authenticated;
                clicked => { root.uninstall-clicked(); }
            }
        }

        ListView {
            vertical-stretch: 3;

            for library[i] in root.libraries: HorizontalLayout {
                spacing: 6px;

                CheckBox {
                    checked: library.checked;
                    toggled => { root.check-toggled(i, self.checked); }
                }

                VerticalLayout {
                    horizontal-stretch: 1;

                    Text {
                        text: library.name;
                        font-weight: 700;
                    }

                    Text {
                        text: library.uuid;
                        font-family: "DejaVu Sans Mono";
                        font-size: 10px;
                        color: #808080;
                        overflow: elide;
                    }
                }

                Text {
                    text: library.installed != "" ? library.installed : "not installed";
                    font-size: 10px;
                    vertical-alignment: center;
                }

                Text {
                    text: library.outdated ? "outdated → " + library.online : "";
                    color: #d08000;
                    font-size: 10px;
                    vertical-alignment: center;
                }

                Button {
                    text: "Get";
                    enabled: root.authenticated;
                    clicked => { root.get-clicked(i); }
                }
            }
        }

        TextEdit {
            text: root.details;
            read-only: true;
            font-family: "DejaVu Sans Mono";
            font-size: 12px;
        }
    }
}
