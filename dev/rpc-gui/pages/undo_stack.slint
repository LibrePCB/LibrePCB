import { Button, ComboBox, TextEdit } from "std-widgets.slint";

export component UndoStackPage {
    in property <bool> authenticated;
    in property <[string]> project-entries;
    in-out property <int> current-index: -1;
    in property <bool> handle-valid;
    in property <string> details;
    callback select-project(string);
    callback get-clicked();
    callback undo-clicked();
    callback redo-clicked();

    VerticalLayout {
        spacing: 8px;

        HorizontalLayout {
            spacing: 6px;

            ComboBox {
                model: root.project-entries;
                current-index <=> root.current-index;
                selected(value) => { root.select-project(value); }
                horizontal-stretch: 1;
            }

            Button {
                text: "Get";
                enabled: root.authenticated && root.handle-valid;
                clicked => { root.get-clicked(); }
            }

            Button {
                text: "Undo";
                enabled: root.authenticated && root.handle-valid;
                clicked => { root.undo-clicked(); }
            }

            Button {
                text: "Redo";
                enabled: root.authenticated && root.handle-valid;
                clicked => { root.redo-clicked(); }
            }
        }

        TextEdit {
            vertical-stretch: 1;
            text: root.details;
            read-only: true;
            font-family: "DejaVu Sans Mono";
            font-size: 12px;
        }
    }
}
